{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "farmer",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "farmer_app/app.py",
        "--server.port",
        "8503",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--",
        "--report",
        "docs/farm_report_demo.json",
        "--fields",
        "docs/gezira_fields_demo.geojson"
      ],
      "port": 8503
    },
    {
      "name": "console",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "console/app.py",
        "--server.port",
        "8505",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--",
        "--report",
        "docs/farm_report_demo.json",
        "--fields",
        "docs/gezira_fields_demo.geojson",
        "--data",
        "demo",
        "--farm",
        "demo"
      ],
      "port": 8505
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "dashboard/app.py",
        "--server.port",
        "8502",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--",
        "--results",
        "docs/sample_results.json"
      ],
      "port": 8502
    },
    {
      "name": "exports",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8504",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8504
    },
    {
      "name": "network-map",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "dashboard/map_app.py",
        "--server.port",
        "8506",
        "--server.address",
        "127.0.0.1",
        "--server.headless",
        "true",
        "--",
        "--results",
        "docs/sample_results.json"
      ],
      "port": 8506
    }
  ]
}
