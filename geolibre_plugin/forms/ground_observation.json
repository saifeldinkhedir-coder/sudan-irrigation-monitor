{
  "form_id": "ground_observation",
  "title": {"en": "Field observation", "ar": "ملاحظة حقلية"},
  "description": {
    "en": "One photograph tied to a field, a date and a GPS position. This is the layer that makes the satellite checkable, and every confirmed observation is a training label.",
    "ar": "صورة واحدة مرتبطة بحقل وتاريخ وموقع GPS. هذه الطبقة تجعل قراءة القمر قابلة للتحقّق، وكل ملاحظة مؤكَّدة هي بيان تدريب."
  },
  "auto_fields": ["lat", "lon", "observed_at", "photo_path", "observer"],
  "fields": [
    {"name": "field_id", "type": "text", "required": true,
     "label": {"en": "Field ID", "ar": "رقم الحقل"}},
    {"name": "crop", "type": "select", "required": false,
     "label": {"en": "Crop", "ar": "المحصول"},
     "options": ["sorghum", "wheat", "cotton", "groundnut", "vegetables", "fallow", "other"]},
    {"name": "growth_stage", "type": "select",
     "label": {"en": "Growth stage", "ar": "مرحلة النمو"},
     "options": ["emergence", "vegetative", "flowering", "grain_fill", "maturity", "harvested"]},
    {"name": "canopy_condition", "type": "select", "required": true,
     "label": {"en": "Canopy condition", "ar": "حالة المجموع الخضري"},
     "options": ["healthy", "patchy", "yellowing", "wilting"],
     "help": {"en": "Used to score whether the satellite agreed with what you saw.",
              "ar": "تُستخدم لتقييم توافق القمر مع ما رأيته."}},
    {"name": "weeds_present", "type": "boolean",
     "label": {"en": "Weeds present?", "ar": "هل توجد أعشاب؟"}},
    {"name": "weed_cover_pct", "type": "number", "min": 0, "max": 100,
     "label": {"en": "Weed cover %", "ar": "نسبة تغطية الأعشاب %"},
     "show_if": {"weeds_present": true}},
    {"name": "pest_damage", "type": "boolean",
     "label": {"en": "Pest damage?", "ar": "أضرار آفات؟"}},
    {"name": "disease_signs", "type": "boolean",
     "label": {"en": "Disease signs?", "ar": "علامات مرض؟"}},
    {"name": "soil_surface", "type": "select",
     "label": {"en": "Soil surface", "ar": "سطح التربة"},
     "options": ["dry", "moist", "waterlogged", "cracked", "crusted"]},
    {"name": "salinity_signs", "type": "boolean",
     "label": {"en": "Salt crust (white)?", "ar": "قشرة ملحية (بيضاء)؟"}},
    {"name": "water_reached_field", "type": "boolean", "required": true,
     "label": {"en": "Did irrigation water reach this field?",
               "ar": "هل وصل ماء الري إلى هذا الحقل؟"},
     "help": {"en": "The direct measurement the satellite only proxies. The single most valuable field at the tail of a canal.",
              "ar": "القياس المباشر الذي لا يقيسه القمر إلا بشكل غير مباشر. أهمّ حقل عند ذيل الترعة."}},
    {"name": "days_since_irrigation", "type": "number", "min": 0,
     "label": {"en": "Days since last irrigation", "ar": "أيام منذ آخر ريّة"}},
    {"name": "outlet_condition", "type": "select",
     "label": {"en": "Outlet condition", "ar": "حالة الفتحة (أبو عشرين)"},
     "options": ["open", "blocked", "damaged", "silted"]},
    {"name": "notes", "type": "textarea",
     "label": {"en": "Notes", "ar": "ملاحظات"}}
  ],
  "on_submit": "bridge.submit_observation",
  "maps_to": "nutrition_climate_ground.GroundObservation",
  "note": "Field names mirror GroundObservation exactly so bridge.py can construct one with no remapping. canopy_condition + water_reached_field are required because they carry the reliability and the delivery signal."
}
